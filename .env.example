# ── Mediconnect Frontend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# (Optional) Override the Vite proxy backend target in development.
# Defaults to http://localhost/mediconnect/backend (XAMPP on port 80).
# Set this if your PHP backend runs on a different port, e.g. PHP built-in server:
#   VITE_BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=

# (Optional) Full backend URL used in the PRODUCTION build.
# Leave blank during development — the Vite proxy handles routing instead.
# Example for a deployed server:
#   VITE_APP_API_URL=https://api.yourdomain.com/mediconnect/backend
VITE_APP_API_URL=
